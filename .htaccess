<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to .env and hidden files
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Forward all traffic to public directory for shared hosting
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
